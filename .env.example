# NEXORA — variables d'environnement pour Netlify (plan gratuit).
# Définis ces variables dans le tableau de bord Netlify du NOUVEAU site
# de la plateforme : Site settings > Environment variables (cocher
# « Production » pour chacune). NE COMMITE JAMAIS les vraies valeurs.
# Les variables d'environnement gagnent toujours sur les valeurs
# enregistrées dans le tableau de bord Patron (table discord_config).
#
# ATTENTION : ce site est un NOUVEAU site Netlify, séparé de la vitrine
# existante (nexora-activate94190.netlify.app) — ne touche jamais à la
# vitrine, elle reste en ligne telle quelle.

# Base de données Postgres (Supabase) — LA base de l'application.
# IMPORTANT (serverless) : utilise l'URI du POOLER Supabase, pas la
# connexion directe. Supabase : dashboard du projet > bouton « Connect »
# > onglet « Transaction pooler » > URI. Elle ressemble à :
#   postgresql://postgres.YOUR-PROJECT:YOUR-DATABASE-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# La connexion directe (db.<ref>.supabase.co:5432, IPv6) ne marche pas
# de façon fiable depuis les fonctions serverless. Pour appliquer les
# migrations en local, utilise l'URI directe (voir README.md).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DATABASE-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Connexion Discord OAuth2 (application « sniko », Client ID
# 1571508442114560112) — portail développeur Discord > OAuth2 >
# « Réinitialiser la clé secrète » si l'actuelle est perdue (elle n'est
# pas copiable). Ne fais JAMAIS transiter ce secret par le chat.
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Adresse de retour OAuth exacte, enregistrée À L'IDENTIQUE dans le
# portail Discord (OAuth2 > Redirects) : l'adresse publique Netlify du
# NOUVEAU site de la plateforme (pas celle de la vitrine).
DISCORD_REDIRECT_URI=https://<ton-site-plateforme>.netlify.app/auth/discord/callback

# Clé de l'API bot : le bot Discord l'envoie pour lire les offres des
# utilisateurs liés (action getDiscordRoles). Choisis une longue chaîne
# aléatoire (32 caractères ou plus) et donne la même au bot
# (variables NEXORA_API_URL + NEXORA_API_KEY du service sniko-bot).
NEXORA_API_KEY=your-long-random-api-key

# Mot de passe d'application Gmail du compte nexora.activate@gmail.com
# (Google > Sécurité > Mots de passe d'application) — envoi SMTP des
# codes d'inscription et des notifications support / serveurs.
# Sans lui, les codes ne partent pas (l'inscription échoue proprement).
GMAIL_APP_PASSWORD=your-gmail-app-password
