{
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hatch/space-sdk": "file:./vendor/space-sdk.tgz",
    "@types/bun": "1.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "name": "nexora",
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "build": "bun run build:client && bun run build:server",
    "build:client": "bun ./client/build.mjs",
    "build:server": "cd server && bun build ./src/index.ts --target=bun --outfile=./dist/index.js",
    "db:migrate": "bunx drizzle-kit migrate",
    "start": "bun run server/src/index.ts",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json"
  },
  "type": "module"
}
